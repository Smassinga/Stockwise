# Dependencies
node_modules/
pnpm-lock.yaml
yarn.lock

# Builds and generated QA evidence
dist/
.vite/
coverage/
/output/
src-tauri/target/
src-tauri/gen/android/keystore.properties
src-tauri/keystore.properties
*.jks
*.keystore
*.p12
*.pem

# Local env files (never commit secrets)
.env*
!.env.example

# Supabase pull artifacts are review-only and should not enter the canonical chain by default
supabase/migrations/*_remote_schema.sql

# Supabase CLI internal runtime state
/supabase/.temp/*
!/supabase/.temp/cli-latest

# Machine-specific Codex environment state
/.codex/environments/

# Local shell, package-manager, browser and scratch state
/.bash_logout
/.bashrc
/.profile
/.sudo_as_admin_successful
/.npm-cache/
/.pip-cache/
/.playwright-cli/
/.tmp*
/tmp_*.js
/auth_config.json
/npm install.txt
/missing_translations.txt
/restored_translations.txt
/runbook*.json

# Logs & misc
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.DS_Store
.idea/
.vscode/
*.local
*.swp
.vercel
