{
  "name": "stockwise",
  "private": true,
  "version": "1.3.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "npm run lint:js && npm run lint:css && npm run check:css-vars && npm run check:css-classes && npm run check:ui-foundations",
    "preview": "vite preview",
    "generate-icons": "node generate-icons.js",
    "generate-tauri-icons": "node generate-tauri-icons.js",
    "lint:css": "stylelint \"src/**/*.css\" --quiet",
    "lint:js": "eslint src --ext ts,tsx",
    "check:css-vars": "node scripts/check-css-variables.js",
    "check:css-classes": "node scripts/check-css-classes.js",
    "check:ui-foundations": "node scripts/check-ui-foundations.mjs",
    "check:migrations": "node scripts/check-supabase-migrations.mjs",
    "test:finance-regression": "node --env-file=.env --test --test-concurrency=1 tests/finance-regression/**/*.test.mjs",
    "test:finance-regression:ci": "node --test --test-concurrency=1 tests/finance-regression/**/*.test.mjs",
    "test:dashboard": "node --test --test-concurrency=1 tests/dashboard/**/*.test.mjs",
    "test:service-jobs": "node --test --test-concurrency=1 tests/service-jobs/**/*.test.mjs",
    "test:communications": "node --test --test-concurrency=1 tests/communications/email-identity-and-reminders.test.mjs tests/communications/collections-control.test.mjs tests/communications/email-content-architecture.test.mjs",
    "test:communications:integration": "node --test --test-concurrency=1 tests/communications/collections-control.integration.test.mjs",
    "test:operational-governance": "node --test --test-concurrency=1 tests/operational-governance/**/*.test.mjs",
    "test:administration-ux": "node --test --test-concurrency=1 tests/administration-ux/**/*.test.mjs",
    "test:ui-regression": "node --test --test-concurrency=1 tests/administration-ux/**/*.test.mjs tests/authenticated-ux/**/*.test.mjs tests/finance-ux/**/*.test.mjs tests/reports-ux/**/*.test.mjs tests/inventory-orders-pos-ux/**/*.test.mjs tests/production-growth-services-ux/**/*.test.mjs",
    "test:opening-quantity": "node --test --test-concurrency=1 tests/opening-quantity/**/*.test.mjs",
    "test:uom-integrity": "node --test --test-concurrency=1 tests/uom-integrity/**/*.test.mjs",
    "test:multi-settlement": "node --test --test-concurrency=1 tests/multi-settlement/**/*.test.mjs",
    "test:receivables-alerts": "node --test --test-concurrency=1 tests/receivables-alerts/**/*.test.mjs",
    "test:assisted-provisioning": "node --test --test-concurrency=1 tests/assisted-provisioning/**/*.test.mjs",
    "test:comms-email-types": "tsc --noEmit --allowImportingTsExtensions --module nodenext --moduleResolution nodenext --target es2022 --skipLibCheck tests/types/email-template-contracts.ts",
    "bootstrap:platform-admin": "node --env-file=.env scripts/bootstrap-platform-admin.mjs",
    "tauri:prepare": "node scripts/prepare-tauri-release.mjs",
    "tauri": "tauri",
    "tauri:dev": "npm run tauri:prepare && tauri dev",
    "tauri:build": "npm run tauri:prepare && tauri build",
    "tauri:desktop:build": "npm run tauri:build",
    "tauri:android:init": "node scripts/run-tauri-android.mjs init --ci true",
    "tauri:android:dev": "npm run tauri:prepare && node scripts/run-tauri-android.mjs dev",
    "tauri:android:apk": "npm run tauri:prepare && npm run build && node scripts/run-tauri-android.mjs release-apk",
    "tauri:android:apk:split": "npm run tauri:prepare && npm run build && node scripts/run-tauri-android.mjs release-apk --split-per-abi",
    "dev:lan": "vite --host 0.0.0.0",
    "lint:css:fix": "stylelint \"src/**/*.css\" --fix --quiet"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-alert-dialog": "^1.1.14",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-collapsible": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-radio-group": "^1.3.7",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-toggle": "^1.1.9",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@sentry/react": "^10.65.0",
    "@supabase/supabase-js": "^2.55.0",
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-dialog": "^2.7.0",
    "@tauri-apps/plugin-fs": "^2.5.0",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "exceljs": "^4.4.0",
    "file-saver": "^2.0.5",
    "framer-motion": "^12.23.12",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "0.452.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-hot-toast": "^2.5.2",
    "react-responsive": "^10.0.1",
    "react-router-dom": "^7.18.2",
    "recharts": "^2.15.4",
    "vaul": "^1.1.2",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@playwright/test": "1.62.1",
    "@sentry/vite-plugin": "^5.4.0",
    "@tauri-apps/cli": "^2.10.1",
    "@types/file-saver": "^2.0.7",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.16",
    "eslint": "^9.33.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "glob": "^11.0.3",
    "globals": "^16.3.0",
    "postcss": "^8.5.26",
    "sharp": "^0.35.4",
    "stylelint": "^16.23.1",
    "stylelint-config-standard": "^39.0.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^3.3.5",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^7.3.6"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1",
      "tmp": "^0.2.6"
    }
  }
}
